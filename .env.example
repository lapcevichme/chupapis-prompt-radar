# Root .env for docker-compose. Copy to .env and override as needed.
# The stack also runs with zero config (compose has sensible dev defaults).

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=prompt_radar
DB_HOST_PORT=5433

# Backend
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
FRONTEND_AUTO_DEMO_LOGIN=true
APP_STAGE=dev
JWT_SECRET=dev-local-jwt-secret-change-me-please-0123456789
DEMO_USER_EMAIL=test@gmail.com
DEMO_USER_PASSWORD=test123
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
INGEST_TOKEN=dev-ingest-token
ML_PROCESSING_TIMEOUT_SEC=600
ML_PROCESSING_POLL_INTERVAL_SEC=1
ML_RECOMPUTE_TIMEOUT_SEC=1800

# Create three built-in analytical workspaces from the demo fixture on first start.
PRELOAD_DATASETS_ENABLED=true
PRELOAD_DATASETS_RECOMPUTE=true

# Backend <-> ML shared service token (must match on both)
ML_SERVICE_TOKEN=dev-ml-token

# ML service
ML_HOST_PORT=8000
QDRANT_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334
LOG_LEVEL=INFO

# Provider/model settings and secrets live in ml_service/.env (copy
# ml_service/.env.example there). docker-compose loads that file directly.
