# Root .env for docker-compose. Copy to .env and override as needed.
# The stack also runs with zero config (compose has sensible dev defaults).

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=prompt_radar
DB_HOST_PORT=5433

# Backend
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
FRONTEND_AUTO_DEMO_LOGIN=true
JWT_SECRET=dev-local-jwt-secret-change-me-please-0123456789
DEMO_USER_EMAIL=test@gmail.com
DEMO_USER_PASSWORD=test123
INGEST_TOKEN=dev-ingest-token

# Backend <-> ML shared service token (must match on both)
ML_SERVICE_TOKEN=dev-ml-token

# ML service
ML_HOST_PORT=8000
QDRANT_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334
QDRANT_COLLECTION=prompt_radar_vectors
# mock | openrouter | ollama
EMBEDDINGS_PROVIDER=mock
EMBEDDINGS_MODE=mock
# qwen3-embedding-4b dimension (collection size)
EMBEDDINGS_DIM=2560
CLASSIFIER_CONFIDENCE_THRESHOLD=0.30
# Set for real embeddings + LLM naming via OpenRouter:
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen3-embedding-4b
# OPENROUTER_CHAT_MODEL=google/gemma-4-26b-a4b-it

LOG_LEVEL=INFO
