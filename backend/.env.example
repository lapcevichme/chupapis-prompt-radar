# App
APP_STAGE=dev
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8080

# DB / cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/prompt_radar
REDIS_URL=redis://redis:6379/0          # optional (statistics/ROI cache)

# Auth
JWT_SECRET=change-me-change-me-change-me-1234
JWT_ALGO=HS256
ACCESS_TTL=900
REFRESH_TTL=604800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
COOKIE_PATH=/
DEMO_USER_EMAIL=demo@prompt-radar.local
DEMO_USER_PASSWORD=DemoPass123!

# ML integration
ML_SERVICE_URL=http://ml-service:8000
ML_SERVICE_TOKEN=change-me-ml-token
ML_INGEST_BATCH_SIZE=200
ML_HTTP_TIMEOUT_SEC=30

# ROI defaults
ROI_FTE_HOURLY_RATE_RUB=1200.0
ROI_TOKEN_COST_PER_1K_RUB=0.015

# Normalization
NORMALIZE_SYNTHESIZE_TIMESTAMPS=true
NORMALIZE_TIMESTAMP_SPAN_DAYS=14
