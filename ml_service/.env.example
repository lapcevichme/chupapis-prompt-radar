# Prompt Radar ML service — copy to .env and fill values.
# Never commit real secrets. OPENROUTER_API_KEY must stay out of git.

# Auth (empty = open local/dev; set in shared environments)
ML_SERVICE_TOKEN=

# Store
QDRANT_URL=http://localhost:6333
ML_META_DB_URL=sqlite:///./ml_meta.db
ML_CONFIG_PATH=./config.yaml

# Classifier
CLASSIFIER_MODEL_PATH=./app/models/catboost_task_classifier.cbm
CLASSIFIER_CONFIDENCE_THRESHOLD=0.60
# fail_fast | llm | embedding_centroid
CLASSIFIER_FALLBACK_MODE=llm

# Embeddings: mock | ollama | openrouter
# Use mock for offline demos / CI (no live LLM).
EMBEDDINGS_PROVIDER=mock
EMBEDDINGS_DIM=384
EMBEDDINGS_BATCH_SIZE=32
EMBEDDINGS_TIMEOUT_SEC=30
EMBEDDINGS_MAX_RETRIES=2
ONLINE_SIMILARITY_THRESHOLD=0.85
RECOMPUTE_CENTROID=true

# Ollama (local embeddings when EMBEDDINGS_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-embedding:4b

# OpenRouter (embeddings + LLM summarization). Leave empty for mock/offline.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-embedding-4b
OPENROUTER_EMBEDDINGS_URL=https://openrouter.ai/api/v1/embeddings
OPENROUTER_CHAT_URL=https://openrouter.ai/api/v1/chat/completions

# Long text
MAX_DIRECT_TOKENS=8000
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# Logging
LOG_LEVEL=INFO
