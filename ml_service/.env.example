# Copy to .env — never commit secrets.

# offline = Ollama | online = OpenRouter
ML_MODE=offline
# Auto-pull missing Ollama models on startup (default true when not mock)
OLLAMA_AUTO_PULL=true
# EMBEDDINGS_MODE=offline
# LLM_MODE=online

# Embeddings: qwen3-embedding 4b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-embedding:4b
OPENROUTER_EMBEDDINGS_URL=https://openrouter.ai/api/v1/embeddings
OPENROUTER_MODEL=qwen/qwen3-embedding-4b

# LLM: Gemma ~26B family
OLLAMA_LLM_MODEL=gemma4:26b-a4b-it
OPENROUTER_CHAT_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_CHAT_MODEL=google/gemma-4-26b-a4b-it
OPENROUTER_API_KEY=

CLASSIFIER_MODEL_PATH=./app/models/catboost_task_classifier.cbm
CLASSIFIER_FALLBACK_MODE=fail_fast
CLASSIFIER_CONFIDENCE_THRESHOLD=0.30

ALLOW_INMEMORY_STORE=true
ML_META_DB_URL=sqlite:///./ml_meta.db
ML_SERVICE_TOKEN=
LOG_LEVEL=INFO
